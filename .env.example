DATABASE_URL=postgresql://user:password@localhost:5432/brand_layer
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public MCP resource identifier for OAuth discovery (defaults to {BETTER_AUTH_URL}/api/mcp)
# MCP_RESOURCE_URL=https://desin.ai/api/mcp

# Encrypts recoverable API keys at rest (AES-256-GCM). Falls back to BETTER_AUTH_SECRET.
# API_KEY_ENCRYPTION_SECRET=

# Apply key_ciphertext column when ready (do not auto-migrate):
#   psql "$DATABASE_URL" -f drizzle/0003_api_key_ciphertext.sql

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required for embeddings (text-embedding-3-small) and dreaming (gpt-4o-mini)
OPENAI_API_KEY=

# Optional: Firecrawl for URL ingest (clean markdown from JS sites).
# Without this, URL extract falls back to plain HTTP fetch + HTML strip.
# FIRECRAWL_API_KEY=fc_...

# Optional overrides
# OPENAI_DREAM_MODEL=gpt-4o-mini
# ALLOW_DEV_API_KEYS=true

# Trigger.dev — create a project at https://cloud.trigger.dev
# TRIGGER_PROJECT_REF=proj_...
# TRIGGER_SECRET_KEY=tr_dev_...   # from API keys page (dev) / dashboard (prod)

# Postgres needs the pgvector extension:
#   CREATE EXTENSION IF NOT EXISTS vector;

# Brand workspace (user-owned brands, no orgs):
#   Apply drizzle migrations via bun db:migrate, or manually:
#   psql "$DATABASE_URL" -f drizzle/0003_wise_human_cannonball.sql
#   psql "$DATABASE_URL" -f drizzle/0004_ordinary_malice.sql
# (prefer migrate; do not auto-migrate in CI).
